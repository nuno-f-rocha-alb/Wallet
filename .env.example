# Copy to .env for docker-compose. All optional; defaults shown.

# Reverse-proxy IP(s) allowed to set identity headers (comma-separated).
# Behind Authelia, set this to your proxy container/host IP. "*" trusts any peer
# (DEV ONLY — never in production).
TRUSTED_PROXIES=

# Header names your proxy forwards the authenticated identity in.
AUTH_HEADER_USER=remote-user
AUTH_HEADER_EMAIL=remote-email
AUTH_HEADER_NAME=remote-name

# Emails granted admin (comma-separated). The very first user is always admin.
ADMIN_EMAILS=

# Local testing without Authelia: forces every request to this identity.
# Leave BOTH empty in production.
AUTH_DEV_USER=
AUTH_DEV_EMAIL=

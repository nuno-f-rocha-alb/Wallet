# Copy to `.env` for docker-compose (`cp .env.example .env`). Everything is optional —
# with an empty file the app boots in local dev-user mode. Defaults are shown.

# ── Auth: behind a reverse proxy + Authelia (production) ─────────────────────────────
# Reverse-proxy IP(s) allowed to set identity headers (comma-separated). Set this to your
# proxy container/host IP so a direct client can't forge an identity. Empty = ignore all
# identity headers. "*" trusts any peer — DEV ONLY, never in production.
TRUSTED_PROXIES=

# Header names your proxy forwards the authenticated identity in (Authelia defaults shown).
AUTH_HEADER_USER=remote-user
AUTH_HEADER_EMAIL=remote-email
AUTH_HEADER_NAME=remote-name

# Emails granted admin (comma-separated). The very first user provisioned is always admin.
ADMIN_EMAILS=

# ── Auth: local testing WITHOUT Authelia ─────────────────────────────────────────────
# Forces every request to this identity. Ignored whenever TRUSTED_PROXIES is set, so it
# can never override a real deployment. Leave BOTH empty in production.
AUTH_DEV_USER=
AUTH_DEV_EMAIL=

# ── Misc ─────────────────────────────────────────────────────────────────────────────
# Reported at GET /api/health. CI stamps the image with the git SHA; set your own if you like.
APP_VERSION=
